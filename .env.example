# Supabase project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public client key (Settings -> API -> Project API keys)
# Newer Supabase projects call this the "publishable" key; older projects
# call it the "anon" key. Either name works — set whichever one your
# dashboard shows you.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-side admin key (Settings -> API -> Project API keys).
# This is the "service_role" (or newer "secret") key. Keep it out of any
# NEXT_PUBLIC_ variable — it must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
